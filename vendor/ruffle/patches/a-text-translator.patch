+/// Scaleform's Translator (Sandbox Engine patch a): the UI backend's translation of a text field's
+/// text, if it gives one.
+fn translate(context: &UpdateContext<'_>, text: &WStr) -> Option<WString> {
+    context
+        .ui
+        .translate_text(&text.to_utf8_lossy())
+        .map(|t| WString::from_utf8(&t))
+}
+
+/// The tags of Flash's HTML text (the ones Elite's string table holds are `font` and `br`).
+const HTML_TAGS: [&str; 11] = ["a", "b", "br", "font", "i", "img", "li", "p", "span", "textformat", "u"];
+
+/// Whether a translation holds one of those tags, opening or closing, so it is set as HTML (a `<`
+/// that starts no such tag, as in "< 1", is text).
+fn looks_like_html(text: &WStr) -> bool {
+    let text = text.to_utf8_lossy().to_ascii_lowercase();
+    text.match_indices('<').any(|(at, _)| {
+        let rest = &text[at + 1..];
+        let rest = rest.strip_prefix('/').unwrap_or(rest);
+        HTML_TAGS
+            .iter()
+            .any(|tag| rest.strip_prefix(tag).is_some_and(|after| after.starts_with([' ', '>', '/'])))
+    })
+}
